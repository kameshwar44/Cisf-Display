# Copy to .env and fill in. .env is git-ignored.

# PostgreSQL connection to the cisf database
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/cisf

# Secret for signing operator sign-in tokens (JWT). Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Secret gate devices (FRS / ANPR / container OCR) send as X-Device-Key
DEVICE_KEY=dev-device-key

# Set to false in production to disable demo scans from the display
ALLOW_SIMULATION=true

# Print API calls, SQL queries (with rows) and live updates to the terminal.
# Default: on, except when NODE_ENV=production
DEBUG_LOG=true

# Optional
# PORT=4000
# SESSION_HOURS=12
# DISPLAY_TZ=Asia/Kolkata
